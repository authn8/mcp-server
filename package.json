    "url": "git+https://github.com/authn8/mcp-server.git"
  },
  "homepage": "https://authn8.com",
  "author": "Authn8",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
