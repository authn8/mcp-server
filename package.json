{
  "name": "@authn8/mcp-server",
  "version": "1.1.3",
  "description": "MCP server for Authn8 2FA code access",
  "mcpName": "io.github.authn8/mcp-server",
  "type": "module",
  "bin": {
    "authn8-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --watch",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "2fa",
    "totp",
    "authn8",
    "authenticator"
  ],
  "repository": {
